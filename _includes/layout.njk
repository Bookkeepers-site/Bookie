<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} — The Bookkeepers Solution</title>
  <meta name="description" content="{{ description or 'Professional bookkeeping services for small and medium businesses in Perth\'s Northern Suburbs, Bindoon and Chittering Valley. Xero, MYOB, QuickBooks specialists.' }}" />
  <link rel="canonical" href="https://www.thebookkeeperssolution.com{{ page.url }}" />
  <meta property="og:title" content="{{ title }} — The Bookkeepers Solution" />
  <meta property="og:description" content="{{ description or 'Taking the stress out of bookkeeping so you can focus on growing your business.' }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.thebookkeeperssolution.com{{ page.url }}" />
  <meta property="og:image" content="https://www.thebookkeeperssolution.com/assets/og-image.png" />
  <meta property="og:site_name" content="The Bookkeepers Solution" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title }} — The Bookkeepers Solution" />
  <meta name="twitter:description" content="{{ description or 'Taking the stress out of bookkeeping so you can focus on growing your business.' }}" />
  <meta name="twitter:image" content="https://www.thebookkeeperssolution.com/assets/og-image.png" />
  <link rel="icon" type="image/png" href="/assets/logo.png" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "AccountingService",
    "name": "The Bookkeepers Solution",
    "description": "Strategic bookkeeping for small and medium businesses in Perth's Northern Suburbs, Bindoon and Chittering Valley — and Australia-wide, remotely.",
    "url": "https://www.thebookkeeperssolution.com",
    "telephone": "+61419143150",
    "email": "Heidi@thebookkeeperssolution.com",
    "image": "https://www.thebookkeeperssolution.com/assets/logo.png",
    "priceRange": "$$",
    "areaServed": [{ "@type": "AdministrativeArea", "name": "Perth Northern Suburbs, WA" },{ "@type": "AdministrativeArea", "name": "Bindoon, WA" },{ "@type": "AdministrativeArea", "name": "Chittering Valley, WA" },{ "@type": "Country", "name": "Australia" }],
    "address": {"@type":"PostalAddress","addressRegion":"WA","addressCountry":"AU"},
    "openingHoursSpecification": {"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday"],"opens":"08:30","closes":"17:00"},
    "sameAs": ["https://www.facebook.com/bookkeeperssolution","https://www.instagram.com/the_bookkeepers_solution/","https://www.linkedin.com/company/the-bookkeepers-solution/"],
    "identifier": {"@type":"PropertyValue","propertyID":"ABN","value":"61 627 827 567"}
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/style.css" />
</head>
<body>
<header class="site-header"><div class="container container--wide"><div class="header-inner">
<a href="/" class="site-logo" aria-label="The Bookkeepers Solution — home"><img src="/assets/logo.png" alt="The Bookkeepers Solution logo" /></a>
<nav class="site-nav" aria-label="Main navigation" id="site-nav"><button class="nav-close" aria-label="Close menu">✕</button><a href="/" {% if page.url == "/" %}class="active"{% endif %}>Home</a><a href="/about/" {% if page.url == "/about/" %}class="active"{% endif %}>About</a><a href="/services/" {% if page.url == "/services/" %}class="active"{% endif %}>Services</a><a href="/health-check/" {% if page.url == "/health-check/" %}class="active"{% endif %}>$49 Health Check</a><a href="/posts/" {% if "/posts/" in page.url %}class="active"{% endif %}>Updates</a><a href="/contact/" {% if page.url == "/contact/" %}class="active"{% endif %}>Contact</a></nav>
<div class="header-actions"><a href="/#newsletter" class="btn btn-outline btn-sm hide-mobile" style="margin-right:8px;">Newsletter</a><a href="/book/" class="btn btn-primary hide-mobile">Book a Call</a><button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav"><span></span><span></span><span></span></button></div>
</div></div></header>
{% if hideHero != true %}<section class="page-hero"><div class="container"><div class="page-hero-inner">{% if eyebrow %}<span class="hero-eyebrow">{{ eyebrow }}</span>{% endif %}<h1>{{ heroTitle or title }}{% if heroTitleEm %} <em>{{ heroTitleEm }}</em>{% endif %}</h1>{% if heroLead %}<p class="hero-lead">{{ heroLead }}</p>{% endif %}</div></div></section>{% endif %}
<main class="page-main"><div class="container"><div class="page-content">{{ content | safe }}</div></div></main>
{% if hideCTA != true %}<section class="cta-section"><div class="container"><h2>Ready to take bookkeeping off your plate?</h2><p>Get in touch for a friendly, no-obligation chat about how we can help your business.</p><div class="cta-actions"><a href="/book/" class="btn btn-white">Book a Free Chat</a><a href="tel:+61419143150" class="btn btn-ghost">Call Us Today</a></div></div></section>{% endif %}
<footer class="site-footer"><div class="container container--wide"><div class="footer-inner"><div class="footer-brand"><a href="/" class="site-logo"><img src="/assets/logo.png" alt="The Bookkeepers Solution logo" /><span style="color:#fff;">The Bookkeepers Solution</span></a><p class="footer-tagline">Professional bookkeeping for small and medium businesses in Western Australia. Local knowledge, modern cloud tools.</p></div><div class="footer-col"><h4>Pages</h4><ul><li><a href="/">Home</a></li><li><a href="/about/">About</a></li><li><a href="/services/">Services</a></li><li><a href="/health-check/">$49 Health Check</a></li><li><a href="/posts/">Updates</a></li><li><a href="/contact/">Contact</a></li><li><a href="/book/">Book a Call</a></li></ul></div><div class="footer-col"><h4>Contact</h4><ul><li><a href="tel:+61419143150">+61 419 143 150</a></li><li><a href="mailto:Heidi@thebookkeeperssolution.com">Heidi@thebookkeeperssolution.com</a></li><li>Perth Northern Suburbs, WA</li></ul><ul class="footer-socials" aria-label="Social media"><li><a href="https://www.facebook.com/bookkeeperssolution" aria-label="Facebook" target="_blank" rel="noopener">Facebook</a></li><li><a href="https://www.instagram.com/the_bookkeepers_solution/" aria-label="Instagram" target="_blank" rel="noopener">Instagram</a></li><li><a href="https://www.linkedin.com/company/the-bookkeepers-solution/" aria-label="LinkedIn" target="_blank" rel="noopener">LinkedIn</a></li></ul></div></div><div class="footer-bottom"><p class="footer-copy">&copy; 2026 The Bookkeepers Solution &middot; ABN 61 627 827 567 &middot; Registered BAS Agent &middot; All rights reserved.</p></div></div></footer>
<script>(function(){var toggle=document.querySelector('.nav-toggle'),close=document.querySelector('.nav-close'),nav=document.querySelector('.site-nav');if(!toggle||!nav)return;function open(){nav.classList.add('is-open');toggle.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';}function shut(){nav.classList.remove('is-open');toggle.setAttribute('aria-expanded','false');document.body.style.overflow='';}toggle.addEventListener('click',open);if(close)close.addEventListener('click',shut);nav.querySelectorAll('a').forEach(function(a){a.addEventListener('click',shut);});})();(function(){if(!('IntersectionObserver' in window))return;document.documentElement.classList.add('js-reveal-ready');var els=document.querySelectorAll('.reveal');var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target);}});},{threshold:0,rootMargin:'0px 0px 50px 0px'});els.forEach(function(el){io.observe(el);});})();</script>
</body></html>